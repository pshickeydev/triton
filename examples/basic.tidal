-- basic.tidal: simple Tidal patterns to get started
-- Evaluate the block under the cursor with Ctrl-J (or one line with Ctrl-L)

d1 $ sound "bd sn ~ sn"
d2 $ sound "~ cp ~ cp"
d3 $ sound "bd(3,8)"
d4 $ sound "hh*4"

-- Change tempo
setcps 0.6

-- Layered pattern
d1 $ sound "bd sn ~ sn" # gain "0.8"
d2 $ sound "[~ cp]*2 ~ [~ cp]"
d3 $ sound "bd(3,8)" # speed "1.5"
d4 $ sound "hh*4" # gain "0.6"

-- Hush everything
hush
